# --- Google Sheets ---
# Email của Service Account (lấy từ Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key của Service Account (copy nguyên, kể cả -----BEGIN PRIVATE KEY-----)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXX\n-----END PRIVATE KEY-----\n"

# ID của Google Sheet (lấy từ URL: docs.google.com/spreadsheets/d/[ID_Ở_ĐÂY]/edit)
GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# --- Gmail (để gửi email thông báo) ---
# Email của bạn
GMAIL_USER=truong3031992@gmail.com

# App Password (KHÔNG phải mật khẩu Gmail thường)
# Tạo tại: myaccount.google.com > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
